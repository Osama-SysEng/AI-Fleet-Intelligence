ENVIRONMENT=development
OPERATOR_TOKENS=replace-with-development-only-token
POSTGRES_DB=fleet
POSTGRES_USER=fleet_app
POSTGRES_PASSWORD=replace-with-local-random-password
DATABASE_URL=postgresql://fleet_app:replace-with-local-random-password@postgres:5432/fleet
BACKEND_PORT=8000
DASHBOARD_PORT=8080
TELEGRAM_SIMULATION_ONLY=true
# There are deliberately no Telegram, SMS, MQTT, dispatch, or vehicle-control secrets in this release.
